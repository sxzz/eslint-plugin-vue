{
  "editor.tabSize": 2,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "json",
    "jsonc",
    "markdown"
  ],
  "files.readonlyInclude": {
    "dist/**": true,
    "docs/rules/index.md": true,
    "lib/configs/base.ts": true,
    "lib/configs/no-layout-rules.ts": true,
    "lib/configs/vue3-*.ts": true,
    "lib/eslint-typegen.d.ts": true,
    "lib/plugin.ts": true,
    "lib/utils/deprecated-html-elements.json": true,
    "lib/utils/html-elements.json": true,
    "lib/utils/svg-elements.json": true,
    "lib/utils/vue3-export-names.json": true,
    "pnpm-lock.yaml": true
  },
  "js/ts.tsdk.path": "./node_modules/typescript/lib",
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
